{
  "version": 2,
  "title": "Toyota Tacoma live log (Mode 01 + UDS 0x22)",
  "scheduler": {
    "tick_ms": 25,
    "max_requests_per_tick": 4,
    "skip_backlog": true
  },
  "recording": {
    "ring_capacity": 12000,
    "record_capacity": 0
  },
  "channels": [
    {
      "id": "rpm",
      "label": "ENGINE RPM",
      "unit": "RPM",
      "priority": 1,
      "interval_ms": 40,
      "request": { "service": "mode01", "pid": 12 },
      "decode": "pid_0c_rpm",
      "gauge": true,
      "plot": { "scale": 1.0, "color": [0, 229, 255] }
    },
    {
      "id": "map",
      "label": "MANIFOLD MAP",
      "unit": "kPa",
      "priority": 1,
      "interval_ms": 40,
      "request": { "service": "mode01", "pid": 11 },
      "decode": "pid_0b_map_kpa",
      "gauge": true,
      "plot": { "scale": 30.0, "color": [255, 193, 7] }
    },
    {
      "id": "tps",
      "label": "THROTTLE TPS",
      "unit": "%",
      "priority": 1,
      "interval_ms": 50,
      "request": { "service": "mode01", "pid": 17 },
      "decode": "pid_11_tps",
      "gauge": true,
      "plot": { "scale": 50.0, "color": [121, 85, 72] }
    },
    {
      "id": "veh_speed",
      "label": "VEHICLE SPEED",
      "unit": "km/h",
      "priority": 2,
      "interval_ms": 80,
      "request": { "service": "mode01", "pid": 13 },
      "decode": "pid_0d_speed_kph",
      "gauge": true,
      "plot": { "scale": 5.0, "color": [176, 190, 197] }
    },
    {
      "id": "lambda",
      "label": "LAMBDA (AFR)",
      "unit": "λ",
      "priority": 2,
      "interval_ms": 80,
      "request": { "service": "mode01", "pid": 36 },
      "decode": "pid_24_lambda",
      "gauge": true,
      "plot": { "scale": 3000.0, "color": [0, 230, 118] }
    },
    {
      "id": "timing",
      "label": "SPARK ADVANCE",
      "unit": "deg",
      "priority": 2,
      "interval_ms": 80,
      "request": { "service": "mode01", "pid": 14 },
      "decode": "pid_0e_timing",
      "gauge": true,
      "plot": { "scale": 100.0, "color": [244, 67, 54] }
    },
    {
      "id": "load",
      "label": "CALC LOAD",
      "unit": "%",
      "priority": 2,
      "interval_ms": 100,
      "request": { "service": "mode01", "pid": 4 },
      "decode": "pid_04_load",
      "gauge": true,
      "plot": { "scale": 50.0, "color": [255, 152, 0] }
    },
    {
      "id": "maf",
      "label": "MAF FLOW",
      "unit": "g/s",
      "priority": 2,
      "interval_ms": 100,
      "request": { "service": "mode01", "pid": 16 },
      "decode": "pid_10_maf_gs",
      "gauge": false,
      "plot": { "scale": 100.0, "color": [63, 81, 181] }
    },
    {
      "id": "stft_b1",
      "label": "STFT B1",
      "unit": "%",
      "priority": 3,
      "interval_ms": 200,
      "request": { "service": "mode01", "pid": 6 },
      "decode": "pid_06_stft_pct",
      "gauge": false,
      "plot": { "scale": 50.0, "color": [0, 188, 212] }
    },
    {
      "id": "ltft_b1",
      "label": "LTFT B1",
      "unit": "%",
      "priority": 3,
      "interval_ms": 500,
      "request": { "service": "mode01", "pid": 7 },
      "decode": "pid_07_ltft_pct",
      "gauge": false,
      "plot": { "scale": 50.0, "color": [77, 182, 172] }
    },
    {
      "id": "ect",
      "label": "COOLANT ECT",
      "unit": "°C",
      "priority": 3,
      "interval_ms": 500,
      "request": { "service": "mode01", "pid": 5 },
      "decode": "pid_05_ect",
      "gauge": true,
      "plot": { "scale": 10.0, "color": [30, 136, 229] }
    },
    {
      "id": "iat",
      "label": "INTAKE IAT",
      "unit": "°C",
      "priority": 3,
      "interval_ms": 500,
      "request": { "service": "mode01", "pid": 15 },
      "decode": "pid_0f_iat",
      "gauge": false,
      "plot": { "scale": 10.0, "color": [156, 39, 176] }
    },
    {
      "id": "baro",
      "label": "BARO PRESS",
      "unit": "kPa",
      "priority": 4,
