    },
    {
      "id": "tacoma_torque_req",
      "label": "TORQUE REQ (UDS)",
      "unit": "raw",
      "priority": 5,
      "interval_ms": 2000,
      "request": { "service": "uds22", "did": 6146 },
      "decode": "did_placeholder_u16",
      "oem_note": "OEM DID TBD — 0x1802 placeholder (engine torque request)",
      "gauge": false,
      "plot": { "scale": 1.0, "color": [171, 71, 188] }
    },
    {
      "id": "tacoma_vvt_angle",
      "label": "VVT ANGLE (UDS)",
      "unit": "raw",
      "priority": 5,
      "interval_ms": 2000,
      "request": { "service": "uds22", "did": 6147 },
      "decode": "did_placeholder_u8",
      "oem_note": "OEM DID TBD — 0x1803 placeholder for intake VVT",
      "gauge": false,
      "plot": { "scale": 50.0, "color": [102, 187, 106] }
    }
  ]
}
