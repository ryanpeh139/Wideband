      "request": { "service": "mode01", "pid": 47 },
      "decode": "pid_2f_fuel_pct",
      "gauge": false,
      "plot": { "scale": 50.0, "color": [139, 195, 74] }
    },
    {
      "id": "ecu_v",
      "label": "ECU SUPPLY",
      "unit": "V",
      "priority": 4,
      "interval_ms": 1000,
      "request": { "service": "mode01", "pid": 66 },
      "decode": "pid_42_ecu_v",
      "gauge": false,
      "plot": { "scale": 100.0, "color": [255, 235, 59] }
    },
    {
      "id": "vbatt",
      "label": "BATTERY (UDS)",
      "unit": "V",
      "priority": 4,
      "interval_ms": 1000,
      "request": { "service": "uds22", "did": 6160 },
      "decode": "did_f010_vbatt",
      "oem_note": "Common bench placeholder DID F010; verify on OEM ECU",
      "gauge": false,
      "plot": { "scale": 100.0, "color": [255, 213, 79] }
    },
    {
      "id": "oil_temp",
      "label": "OIL TEMP (UDS)",
      "unit": "°C",
      "priority": 4,
      "interval_ms": 1000,
      "request": { "service": "uds22", "did": 6161 },
      "decode": "did_f011_oil_temp",
      "oem_note": "Placeholder F011 — Tacoma/Denso DID may differ",
      "gauge": false,
      "plot": { "scale": 10.0, "color": [255, 87, 34] }
    },
    {
      "id": "tacoma_cat_temp",
      "label": "CAT TEMP (UDS)",
      "unit": "raw",
      "priority": 5,
      "interval_ms": 2000,
      "request": { "service": "uds22", "did": 6145 },
