{
  "version": 2,
  "title": "Toyota Tacoma live log (Mode 01 + UDS 0x22)",
  "scheduler": {
    "tick_ms": 25,
    "max_requests_per_tick": 6,
    "skip_backlog": true
  },
  "recording": {
    "ring_capacity": 12000,
    "record_capacity": 0
  },
  "channels": [
    {
      "id": "rpm",
      "label": "ENGINE RPM",
      "unit": "RPM",
      "priority": 1,
      "interval_ms": 40,
      "request": { "service": "mode01", "pid": 12 },
      "decode": "pid_0c_rpm",
      "gauge": true,
      "plot": { "scale": 1.0, "color": [0, 229, 255] }
    },
    {
      "id": "map",
      "label": "MANIFOLD MAP",
      "unit": "kPa",
      "priority": 1,
      "interval_ms": 100,
      "request": { "service": "mode01", "pid": 11 },
      "decode": "pid_0b_map_kpa",
      "gauge": true,
      "plot": { "scale": 30.0, "color": [255, 193, 7] }
    },
    {
      "id": "tps",
      "label": "THROTTLE TPS",
      "unit": "%",
      "priority": 1,
      "interval_ms": 50,
      "request": { "service": "mode01", "pid": 17 },
      "decode": "pid_11_tps",
      "gauge": true,
      "plot": { "scale": 50.0, "color": [121, 85, 72] }
    },
    {
      "id": "veh_speed",
      "label": "VEHICLE SPEED",
      "unit": "km/h",
      "priority": 2,
      "interval_ms": 100,
      "request": { "service": "mode01", "pid": 13 },
      "decode": "pid_0d_speed_kph",
      "gauge": true,
      "plot": { "scale": 5.0, "color": [176, 190, 197] }
    },
    {
      "id": "lambda",
      "label": "LAMBDA (AFR)",
      "unit": "λ",
      "priority": 2,
      "interval_ms": 100,
      "request": { "service": "mode01", "pid": 36 },
      "decode": "pid_24_lambda",
      "gauge": true,
      "plot": { "scale": 3000.0, "color": [0, 230, 118] }
    },
    {
      "id": "timing",
      "label": "SPARK ADVANCE",
      "unit": "deg",
      "priority": 2,
      "interval_ms": 100,
      "request": { "service": "mode01", "pid": 14 },
      "decode": "pid_0e_timing",
      "gauge": true,
      "plot": { "scale": 100.0, "color": [244, 67, 54] }
    },
    {
      "id": "load",
      "label": "CALC LOAD",
      "unit": "%",
      "priority": 2,
      "interval_ms": 100,
      "request": { "service": "mode01", "pid": 4 },
      "decode": "pid_04_load",
      "gauge": true,
      "plot": { "scale": 50.0, "color": [255, 152, 0] }
    },
    {
      "id": "maf",
      "label": "MAF FLOW",
      "unit": "g/s",
      "priority": 2,
      "interval_ms": 100,
      "request": { "service": "mode01", "pid": 16 },
      "decode": "pid_10_maf_gs",
      "gauge": false,
      "plot": { "scale": 100.0, "color": [63, 81, 181] }
    },
    {
      "id": "stft_b1",
      "label": "STFT B1",
      "unit": "%",
      "priority": 3,
      "interval_ms": 250,
      "request": { "service": "mode01", "pid": 6 },
      "decode": "pid_06_stft_pct",
      "gauge": false,
      "plot": { "scale": 50.0, "color": [0, 188, 212] }
    },
    {
      "id": "ltft_b1",
      "label": "LTFT B1",
      "unit": "%",
      "priority": 3,
      "interval_ms": 1000,
      "request": { "service": "mode01", "pid": 7 },
      "decode": "pid_07_ltft_pct",
      "gauge": false,
      "plot": { "scale": 50.0, "color": [77, 182, 172] }
    },
    {
      "id": "ect",
      "label": "COOLANT ECT",
      "unit": "°C",
      "priority": 3,
      "interval_ms": 1000,
      "request": { "service": "mode01", "pid": 5 },
      "decode": "pid_05_ect",
      "gauge": true,
      "plot": { "scale": 10.0, "color": [30, 136, 229] }
    },
    {
      "id": "iat",
      "label": "INTAKE IAT",
      "unit": "°C",
      "priority": 3,
      "interval_ms": 1000,
      "request": { "service": "mode01", "pid": 15 },
      "decode": "pid_0f_iat",
      "gauge": false,
      "plot": { "scale": 10.0, "color": [156, 39, 176] }
    },
    {
      "id": "baro",
      "label": "BARO PRESS",
      "unit": "kPa",
      "priority": 4,
      "interval_ms": 5000,
      "request": { "service": "mode01", "pid": 51 },
      "decode": "pid_33_baro_kpa",
      "gauge": false,
      "plot": { "scale": 20.0, "color": [96, 125, 139] }
    },
    {
      "id": "fuel_lvl",
      "label": "FUEL LEVEL",
      "unit": "%",
      "priority": 4,
      "interval_ms": 2000,
      "request": { "service": "mode01", "pid": 47 },
      "decode": "pid_2f_fuel_pct",
      "gauge": false,
      "plot": { "scale": 50.0, "color": [139, 195, 74] }
    },
    {
      "id": "vbatt",
      "label": "BATTERY",
      "unit": "V",
      "priority": 4,
      "interval_ms": 1000,
      "request": { "service": "mode01", "pid": 66 },
      "decode": "pid_42_ecu_v",
      "gauge": false,
      "plot": { "scale": 100.0, "color": [255, 213, 79] }
    },
    {
      "id": "oil_temp",
      "label": "OIL TEMP",
      "unit": "°C",
      "priority": 4,
      "interval_ms": 2000,
      "request": { "service": "uds22", "did": 4219 },
      "decode": "did_107b_oil_temp",
      "oem_note": "Toyota ECM DID 0x107B byte 25 (2017 Tacoma 2GR-FKS, matched to Techstream)",
      "gauge": false,
      "plot": { "scale": 10.0, "color": [255, 87, 34] }
    },
    {
      "id": "tacoma_cat_temp",
      "label": "CAT TEMP B1S1",
      "unit": "°C",
      "priority": 5,
      "interval_ms": 2000,
      "request": { "service": "mode01", "pid": 60 },
      "decode": "pid_3c_cat_temp",
      "gauge": false,
      "plot": { "scale": 1.0, "color": [233, 30, 99] }
    },
    {
      "id": "atf_temp",
      "label": "ATF TEMP",
      "unit": "°C",
      "priority": 5,
      "interval_ms": 2000,
      "request": { "service": "uds22", "did": 5671 },
      "decode": "did_1627_atf_temp",
      "oem_note": "Toyota DID 0x1627 A/T oil temperature No.1, read from the ECM (matched to Techstream)",
      "gauge": false,
      "plot": { "scale": 10.0, "color": [171, 71, 188] }
        },
    {
      "id": "nt_speed",
      "label": "TURBINE SPEED",
      "unit": "rpm",
      "priority": 2,
      "interval_ms": 100,
      "request": { "service": "uds22", "did": 5633 },
      "decode": "did_1601_nt_speed",
      "oem_note": "Toyota DID 0x1601 NT (turbine) sensor speed, read from the ECM (matched to Techstream)",
      "gauge": false,
      "plot": { "scale": 1.0, "color": [0, 188, 212] }
    },
    {
      "id": "atf_temp2",
      "label": "ATF TEMP 2",
      "unit": "°C",
      "priority": 5,
      "interval_ms": 2000,
      "request": { "service": "uds22", "did": 5672 },
      "module": "tcm",
      "decode": "did_1628_atf_temp2",
      "oem_note": "Toyota TCM DID 0x1628 A/T oil temperature No.2 (2017 Tacoma TCM on 0x701)",
      "gauge": false,
      "plot": { "scale": 10.0, "color": [156, 39, 176] }
        },
    {
      "id": "shift_lever",
      "label": "SHIFT LEVER (0=P 1=R 2=N 3=D)",
      "unit": "",
      "priority": 3,
      "interval_ms": 250,
      "request": { "service": "uds22", "did": 4113 },
      "module": "tcm",
      "decode": "did_1011_shift_lever",
      "oem_note": "Toyota TCM DID 0x1011 shift switches (mapped by shifting P-R-N-D on a 2017 Tacoma)",
      "gauge": false,
      "plot": { "scale": 500.0, "color": [255, 255, 255] }
    },
    {
      "id": "brake_sw",
      "label": "BRAKE SWITCH",
      "unit": "",
      "priority": 4,
      "interval_ms": 500,
      "request": { "service": "uds22", "did": 4113 },
      "module": "tcm",
      "decode": "did_1011_brake",
      "oem_note": "Toyota TCM DID 0x1011 byte 1 bit 0 (stop light switch)",
      "gauge": false,
      "plot": { "scale": 500.0, "color": [244, 67, 54] }
    }
  ]
}